{
	"name": "microbit-ide-workspace-storage",
	"displayName": "micro:bit IDE Workspace Storage",
	"description": "Provides memfs / idbfs / localfs file-system providers for the micro:bit Web IDE.",
	"publisher": "carlosperate",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "node esbuild.config.mjs"
	},
	"engines": {
		"vscode": "^1.91.0"
	},
	"browser": "./dist/extension.js",
	"activationEvents": [
		"onFileSystem:memfs",
		"onFileSystem:idbfs",
		"onFileSystem:localfs",
		"onStartupFinished"
	],
	"contributes": {
		"commands": [
			{
				"command": "microbitIde.switchStorage",
				"title": "micro:bit IDE: Switch Workspace Storage"
			},
			{
				"command": "microbitIde.openLocalFolder",
				"title": "micro:bit IDE: Open Local Folder (File System Access)"
			}
		]
	}
}
