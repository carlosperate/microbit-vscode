{
	"name": "microbit-ide-workspace-storage",
	"displayName": "micro:bit IDE Workspace Storage",
	"description": "Serves the micro:bit Web IDE's project folder from temporary, browser or local folder storage.",
	"publisher": "carlosperate",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "node esbuild.config.mjs"
	},
	"engines": {
		"vscode": "^1.91.0"
	},
	"browser": "./dist/extension.js",
	"enabledApiProposals": ["fileSearchProvider", "textSearchProvider", "resolvers"],
	"activationEvents": [
		"onFileSystem:microbit",
		"onStartupFinished"
	],
	"contributes": {
		"commands": [
			{
				"command": "microbitIde.switchStorage",
				"title": "micro:bit IDE: Switch Workspace Storage"
			},
			{
				"command": "microbitIde.openLocalFolder",
				"title": "micro:bit IDE: Open Local Folder"
			},
			{
				"command": "microbitIde.useBrowserStorage",
				"title": "micro:bit IDE: Switch to Browser Storage"
			},
			{
				"command": "microbitIde.useTemporaryStorage",
				"title": "micro:bit IDE: Switch to Temporary Storage"
			}
		],
		"menus": {
			"statusBar/remoteIndicator": [
				{
					"command": "microbitIde.useTemporaryStorage",
					"group": "virtualfs_10_microbit_storage@1"
				},
				{
					"command": "microbitIde.useBrowserStorage",
					"group": "virtualfs_10_microbit_storage@2"
				},
				{
					"command": "microbitIde.openLocalFolder",
					"group": "virtualfs_10_microbit_storage@3"
				}
			]
		}
	}
}
