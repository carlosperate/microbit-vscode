{
  "name": "microbit-vscode",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-only VS Code (micro:bit Web IDE) for static GitHub Pages deployment.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:ext": "node scripts/build-extension.mjs",
    "build:extensions": "node scripts/fetch-openvsx.mjs",
    "check:extensions": "node scripts/fetch-openvsx.mjs --check",
    "dev": "npm run build && sirv dist --port 8080 --single",
    "test": "vitest",
    "clean": "rimraf dist .cache"
  },
  "dependencies": {
    "vscode-web": "^1.91.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.91.0",
    "esbuild": "^0.21.0",
    "fake-indexeddb": "^6.2.5",
    "rimraf": "^5.0.5",
    "semver": "^7.8.1",
    "sirv-cli": "^2.0.2",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "yauzl": "^3.1.3"
  }
}
